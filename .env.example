# CodeForge Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Application
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret

# Database (internal docker network — no port change needed)
DATABASE_URL=postgresql+asyncpg://codeforge:codeforge_secret@db:5432/codeforge

# LLM API Keys (set the ones you have — at least one is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Tavily web-search key (optional) — powers the "latest models" scout that
# augments model discovery with newly-announced models not yet in vendor APIs.
# Get a free key at https://tavily.com. When unset, discovery uses vendor APIs only.
TAVILY_API_KEY=

# Rate Limits (requests per minute)
RATE_LIMIT_OPENAI=10
RATE_LIMIT_ANTHROPIC=10
RATE_LIMIT_GOOGLE=10
RATE_LIMIT_GROK=10
RATE_LIMIT_OLLAMA=100

# Code Execution
DOCKER_SOCKET=/var/run/docker.sock
EXECUTION_TIMEOUT=60
# КАО#R4-S5sug — per-run cap used by the sandbox executor service (compose sandbox env)
MAX_EXECUTION_TIME=60
MAX_MEMORY_MB=512
SANDBOX_IMAGE=codeforge-python-sandbox:latest
SANDBOX_API_KEY=codeforge-sandbox-secret

# SMTP (for email OTP login — leave empty for dev mode where OTP is logged to console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=you@gmail.com
# SMTP_USE_TLS=true

# Auth — Email OTP whitelist (comma-separated, supports wildcards e.g. *@company.com)
# When neither SMTP_HOST nor CODEFORGE_API_KEY is set, auth is disabled (dev mode).
# ALLOWED_EMAILS=user@example.com,*@company.com
# ADMIN_EMAIL=admin@example.com
# КАО#R4-S5sug — machine API key (Authorization: Bearer) for programmatic clients
# CODEFORGE_API_KEY=

# CORS — comma-separated origins. Unset: '*' auto-restricts to the known origins
# (gotcode.ai, stage.gotcode.ai, localhost). КАО#R4-S5sug
# CORS_ORIGINS=https://your-domain.example

# Workflow Defaults
DEFAULT_MAX_ITERATIONS=5
DEFAULT_AUTO_CONTINUE=true

# Frontend (Vite build-time — empty means use relative paths via nginx proxy)
VITE_API_URL=
VITE_WS_URL=
